GEMINI_API_KEY=
DEEPGRAM=
GEMINI_MODEL=gemini-3.8-flash
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-US
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
DEEPGRAM_TTS_TRANSPORT=websocket
# Optional: python main.py --backend deepgram-agent
DEEPGRAM_AGENT_PROVIDER=open_ai
DEEPGRAM_AGENT_MODEL=gpt-4o-mini
# Standard managed-agent planning rate; review when changing model/tier.
COST_DEEPGRAM_AGENT_PER_MINUTE=0.075
# Enable only with consent for synthetic service/order/delivery details to reach the hosted agent.
AGENT_SHARE_SYNTHETIC_SERVICE_DETAILS=false
CALL_IDLE_TIMEOUT_SECONDS=45
CALL_IDLE_GRACE_SECONDS=20
CALL_IDLE_CHECKIN_SECONDS=15
DEEPGRAM_ENDPOINTING_MS=1100
# Must match the embedding model used to create the existing FAISS index.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
MONGODB_URI=
# The legacy seed loader populated telecaller, not sundirect_support.
MONGODB_DATABASE=telecaller
CALLER_PHONE=
SUPPORT_TICKET_TEMPLATE=
# Optional inbound Twilio pilot: python -m uvicorn telecom_support.phone_server:app --port 8000
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated +91 pilot callers. If empty, CALLER_PHONE is used.
TWILIO_ALLOWED_CALLERS=
TWILIO_MAX_CALLS=1
# Optional: verify missing-signature callbacks using Twilio's authenticated live-call API.
# Invalid signatures are always rejected. Completed/stale calls cannot be replayed.
TWILIO_VERIFY_UNSIGNED_CALLS=false
# Gemini 3.8 Flash standard introductory rates through 2026-12-31; review at expiry.
COST_GEMINI_INPUT_PER_MILLION=0.75
COST_GEMINI_OUTPUT_PER_MILLION=3.75
COST_STT_PER_MINUTE=0.0077
COST_TTS_PER_1000_CHARACTERS=0.030
